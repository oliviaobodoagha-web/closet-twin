# Copy this file to .env and paste your keys (never commit .env).
# The app also finds a .env one folder above the repo (the teaching staff's submissions/.env).

# Required: course Portkey key. Every text agent runs on gpt-6-luna through it.
PORTKEY_API_KEY=

# Optional: your own OpenAI key, used for pictures only (gpt-image-2.5-sunburst, billed to you):
# outfit mock-ups, product shots, the goal picture, photo try-on and 360° spin.
# Leave empty and everything else still works.
OPENAI_API_KEY=

# Optional spending caps (defaults shown)
# MAX_USD_PER_RUN=0.05
# MAX_USD_PER_LIVE_WEB_RUN=0.15
# MAX_USD_PER_DAY=1.00
# MAX_USD_PER_DAY_IMAGES=2.00
